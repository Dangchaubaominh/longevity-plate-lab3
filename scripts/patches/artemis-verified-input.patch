+    async def _verified_ascii_input(self, text: str, clear_existing: bool, package: str) -> bool:
+        """Opt-in native input with read-back from the focused app field.
+
+        Clipboard set success alone does not prove KEYCODE_PASTE reached EditText
+        (observed on OPPO Android 16). Do not type if focus cannot be verified.
+        """
+        async def focused_text() -> str | None:
+            if await self.get_current_package() != package:
+                return None
+            screen = await self.get_screen_data()
+            fields = [node for node in screen.ui_elements
+                      if node.get("package") == package
+                      and "EditText" in node.get("class", "")
+                      and str(node.get("focused", "")).lower() == "true"]
+            return str(fields[0].get("text", "")) if len(fields) == 1 else None
+
+        try:
+            before = await focused_text()
+            if before is None:
+                logger.warning("Verified input refused: focused app field unavailable")
+                return False
+            expected = text if clear_existing else before + text
+            # ACTION_SET_TEXT bypasses keyboard composition, not application
+            # validation. Native input text is transformed by Vietnamese Telex
+            # on OPPO (ARTEMIS becomes ẢTEMIS), so key injection is not reliable.
+            ui_device = getattr(self._ui_adb_client, "_device", None)
+            if ui_device is None:
+                logger.warning("Verified input refused: accessibility device unavailable")
+                return False
+            field = ui_device(focused=True, packageName=package, className="android.widget.EditText")
+            await asyncio.to_thread(field.set_text, expected)
+            actual = await focused_text()
+            if actual != expected:
+                logger.warning("Verified input failed: app field does not match expected value")
+                return False
+            return True
+        except Exception:
+            logger.exception("Verified native input failed")
+            return False
