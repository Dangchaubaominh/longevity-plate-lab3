{
  "name": "longevity-plate-reports",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:legacy && vitest run",
    "test:legacy": "node --test test/index.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "openapi": "node --experimental-strip-types scripts/generate-openapi.mjs && node scripts/check-openapi.mjs",
    "security": "node scripts/check-secrets.mjs",
    "smoke:cloudinary": "node scripts/cloudinary-smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "latest",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "vitest": "^5.1.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
