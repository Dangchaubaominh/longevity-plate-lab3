{
  "name": "longevity-plate-admin",
  "private": true,
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
